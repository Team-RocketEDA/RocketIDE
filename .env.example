# Copy to .env (install.sh does this once). Never commit real keys.

# The design agent's model, as provider/model. The default is still Meta Muse Spark 1.3. Any provider the
# pinned OpenCode 1.19.5 runtime supports works without changing source code:
#   openai/gpt-5.1            anthropic/claude-sonnet-4-5      google/gemini-2.5-pro
#   deepseek/deepseek-chat    groq/llama-3.3-70b-versatile     ollama/llama3.3
# A configuration saved in the app's Settings wins over this file; an exported value wins over both.
ROCKET_MODEL=meta/muse-spark-1.3

# Optional per-role overrides. An empty value inherits ROCKET_MODEL. The small/helper model has a fallback;
# the reviewer keeps Muse Wonder 1.0 while the main model is Meta, and otherwise inherits the main model.
# Write provider/model, or just a model ID to use the main provider.
# ROCKET_SMALL_MODEL=
# ROCKET_TUTOR_MODEL=
# ROCKET_REVIEWER_MODEL=

# A custom OpenAI-compatible endpoint. Native providers (OpenAI, Anthropic, Gemini, ...) need neither:
# ROCKET_PROVIDER_TYPE is then "native" and OpenCode supplies the provider itself.
# ROCKET_PROVIDER_TYPE=openai-compatible
# ROCKET_BASE_URL=https://your-api.example.com/v1

# The API key for the selected provider. The easiest place is the app's assistant Settings, which keeps it in
# a private file outside this folder and wins over this line. MODEL_API_KEY is Meta's name (and is accepted as
# the key for a custom endpoint); native providers also use OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
# Without one, the IDE and engine checks still work, and ./run.sh replay plays back recorded sessions.
MODEL_API_KEY=

# Read-only PDK folders for the agent, separated by ":".
ROCKET_PDK_ROOTS=

# The PDK the engine registers at install (rocket-engine/scripts/install.sh). Default ~/.local/share/pdk/sky130A,
# which install.sh downloads if it isn't there.
# PDK_SOURCE=
# PDK_ID=sky130A

# Where the shared engine listens, loopback only (run.sh).
# ROCKET_ENGINE_PORT=8765

# Optional: where provider configuration and credentials live, if not ~/.config/rocketide/.
# ROCKET_MODEL_CONFIG=~/.config/rocketide/model.json
# ROCKET_CREDENTIALS_FILE=~/.config/rocketide/credentials

# Optional transparent relay, only for OpenAI-compatible endpoints (native providers keep their own protocol).
# It forwards requests unchanged and streams replies through. The Rocket Fuel plugin logs model activity even
# without it. ROCKET_META_UPSTREAM / ROCKET_META_RELAY_PORT / ROCKET_META_CALL_LOG still work as aliases.
# ROCKET_RELAY_UPSTREAM=https://api.example.com
# ROCKET_MODEL_RELAY_PORT=8766
