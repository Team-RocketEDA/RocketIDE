# Copy to .env (install.sh does this once). Never commit real keys.

# The agent's model. Only Meta models run.
ROCKET_MODEL=meta/muse-spark-1.3

# Your Meta Model API key. Without one, the IDE and engine checks still work, and ./run.sh replay plays back
# recorded Muse Spark sessions.
MODEL_API_KEY=

# Read-only PDK folders for the agent, separated by ":".
ROCKET_PDK_ROOTS=

# The PDK the engine registers at install (rocket-engine/scripts/install.sh). Default ~/.local/share/pdk/sky130A,
# which install.sh downloads if it isn't there.
# PDK_SOURCE=
# PDK_ID=sky130A

# Where the shared engine listens, loopback only (run.sh).
# ROCKET_ENGINE_PORT=8765

# The port of the relay that logs every Meta Model API call, loopback only (run.sh).
# ROCKET_META_RELAY_PORT=8766
