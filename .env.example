# Copy to .env (install.sh does this once). Never commit real keys.

# The agent's model. Free and keyless, sharing one quota per machine:
ROCKET_MODEL=opencode/beam-free
# Muse Spark, once MODEL_API_KEY below is set:
# ROCKET_MODEL=meta/muse-spark-1.3

MODEL_API_KEY=

# Other providers read their usual variable, e.g. OPENROUTER_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY.

# Read-only PDK folders for the agent, separated by ":".
ROCKET_PDK_ROOTS=
